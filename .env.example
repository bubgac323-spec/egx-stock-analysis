# رابط قاعدة بيانات PostgreSQL (مثل Neon أو Vercel Postgres أو PostgreSQL محلي)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# مفتاح Mansa API (الخطة المجانية: 100 طلب/يوم، 1500 طلب/شهر)
# احصل عليه من https://mansaapi.com — لا تضعه أبداً في كود المتصفح
MANSA_API_KEY=

# مفتاح سري لحماية صفحة الإدارة ونقطة التحديث اليدوي ومهام Cron
ADMIN_KEY=

# اختياري: مفتاح Cron الخاص بـ Vercel (يُمرَّر في ترويسة Authorization: Bearer)
CRON_SECRET=
